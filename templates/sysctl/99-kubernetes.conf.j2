# Managed by ansible-role-kubernetes
# https://github.com/istio/istio/issues/36821
fs.inotify.max_user_watches = 1048576
fs.inotify.max_user_instances = 1024
net.bridge.bridge-nf-call-iptables = 1
net.bridge.bridge-nf-call-ip6tables = 1
net.ipv4.ip_forward = 1
{% if kubernetes_node_port_range is defined %}
net.ipv4.ip_local_reserved_ports = {{ kubernetes_node_port_range }}
{% endif %}
